# Copy to .env and fill in your values. Never commit .env.

# Environment: development | testing | production
FLASK_ENV=development

# Secret key for session/flash signing. REQUIRED in production.
SECRET_KEY=change-me

# PostgreSQL connection string (development).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
# NOTES:
#  - port 15432 (127.0.0.1 only) to avoid clashing with other local
#    PostgreSQL instances or tunnels on this machine.
#  - use 127.0.0.1, NOT "localhost": localhost may resolve to IPv6 ::1
#    first, and the container only listens on IPv4.
DATABASE_URL=postgresql+psycopg://supportiq:supportiq@127.0.0.1:15432/supportiq

# docker-compose overrides (defaults shown, used by ./docker-compose.yml)
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=supportiq
POSTGRES_DB=supportiq
POSTGRES_PORT=15432

# Embeddings (Fase 3). FREE TIER ONLY: this project must run at USD 0 —
# no billing, no credit card, paid services are forbidden.
# provider: gemini (real) | fake (in-process, used by the test suite)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Free key from https://aistudio.google.com/apikey (leave empty to skip
# real Gemini verification; the fake provider still works).
EMBEDDING_API_KEY=

# Optional: run the PostgreSQL/pgvector tests (they SKIP if unset).
# Must point at a SEPARATE database (created automatically on first run).
#TEST_DATABASE_URL=postgresql+psycopg://supportiq:supportiq@127.0.0.1:15432/supportiq_test


# Automatic classification (Fase 3). EXPLICIT boolean: true | false only
# (any other value fails at startup). Development defaults to false and
# reads this variable; Testing ignores it on purpose; base/production
# default to true. NEVER derived from EMBEDDING_PROVIDER: enabling the
# classifier implies nothing about which provider embeds (and vice
# versa). Enable it for real-provider demos:
#CLASSIFICATION_ENABLED=true
